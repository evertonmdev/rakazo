#!/usr/bin/env python3
"""Drive the visible computer Chrome with Jev Ultrafast.

Default Rakazo page tools stay in place. This runner is used only when the
bot setting "Ativar ultrafast" is on. It attaches to the Chromium already on
DISPLAY (the computer-use screen), activates that tab, and runs the Jev loop.
Text fields use Mercury 3. TypeSafe still chooses the operation and target.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import sys
import time
from pathlib import Path

VENDOR = Path("/usr/local/lib/rakazo-ultrafast")
if not VENDOR.is_dir():
    VENDOR = Path(__file__).with_name("vendor")
if VENDOR.is_dir():
    sys.path.insert(0, str(VENDOR))

os.environ.setdefault("TEXT_MODEL", "inception/mercury-3")
os.environ.setdefault("TEXT_MODEL_BASE_URL", "https://openrouter.ai/api/v1")
os.environ.setdefault("TEXT_MODEL_REASONING", "none")


def load_page_browser():
    path = Path("/usr/local/bin/rakazo-page-browser")
    if not path.is_file():
        path = Path(__file__).with_name("rakazo-page-browser")
    loader = importlib.machinery.SourceFileLoader("rakazo_page_browser", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise RuntimeError("rakazo-page-browser is not installed on this computer")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def ensure_visible_cdp(page, port):
    """Cold computers need the normal visible launcher, never a headless replacement."""
    try:
        page.http_get_json(f'http://127.0.0.1:{port}/json/version', timeout=1)
        return
    except Exception:
        pass
    import subprocess
    process = subprocess.Popen(['/usr/local/bin/rakazo-browser', 'about:blank'],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, start_new_session=True)
    # Reap the launcher if it exits; do not close the user's browser on runner exit.
    import threading
    threading.Thread(target=process.wait, daemon=True).start()
    try:
        page.wait_for_cdp(port, timeout_s=12)
    except Exception:
        from jev_ultrafast.diagnostics import OperationFailure
        raise OperationFailure('BROWSER_CDP_UNAVAILABLE', 'initialize') from None


class VisibleBrowser:
    """Jev browser bound to the tab the user already sees."""

    def __init__(self, url: str):
        page = load_page_browser()
        self._page = page
        port = page.cdp_port()
        ensure_visible_cdp(page, port)
        self.client = page.CdpClient(page.discover_ws_url(port))
        self.client.connect()
        self.session = page.attach_page(self.client)
        self._install_cdp()
        from jev_ultrafast.evidence import NetworkCapture
        self.network = NetworkCapture(self.session)
        original_event = self.client._handle_event
        def handle_event(message):
            original_event(message)
            self.network.event(message)
        self.client._handle_event = handle_event
        # Capture must be enabled before the first navigation. Chrome bounds body buffers.
        self.call("Network.enable", maxTotalBufferSize=1048576,
                  maxResourceBufferSize=32768, maxPostDataSize=0)
        self._activate_visible_tab()
        self.after_input = None
        self.target = "visible"
        self._navigate_and_wait(url)

    def _activate_visible_tab(self) -> None:
        targets = self.client.call("Target.getTargets").get("targetInfos") or []
        for target in targets:
            if not isinstance(target, dict) or target.get("type") != "page":
                continue
            attached = self.client.call(
                "Target.attachToTarget",
                {"targetId": target["targetId"], "flatten": True},
            )
            if attached.get("sessionId") == self.session:
                self.client.call("Target.activateTarget", {"targetId": target["targetId"]})
                break

    def _navigate_and_wait(self, url: str, timeout_s: float = 15) -> None:
        """Wait for the navigation we started, not the page that was already complete."""
        self.call("Page.enable")
        self.call("Page.setLifecycleEventsEnabled", enabled=True)
        frame = self.call("Page.getFrameTree")["frameTree"]["frame"]
        frame_id = frame["id"]
        previous = frame.get("loaderId")
        nav = self.call("Page.navigate", url=url)
        if nav.get("errorText"):
            raise RuntimeError(f"navigation failed: {nav['errorText']}")
        started = nav.get("loaderId") or ""
        frame_id = nav.get("frameId") or frame_id
        if not started:
            self._wait_until_ready(timeout_s)
            return
        deadline = time.monotonic() + timeout_s
        while time.monotonic() < deadline:
            self.call("Runtime.evaluate", expression="1", returnByValue=True)
            current, reached = self.client._lifecycle.get((self.session, frame_id), (None, set()))
            if (
                current
                and current != previous
                and "load" in reached
                and self._document_ready()
            ):
                return
            time.sleep(0.05)
        raise TimeoutError("page did not finish loading")

    def _wait_until_ready(self, timeout_s: float) -> None:
        deadline = time.monotonic() + timeout_s
        while time.monotonic() < deadline:
            if self._document_ready():
                return
            time.sleep(0.05)
        raise TimeoutError("page did not finish loading")

    def _document_ready(self) -> bool:
        try:
            return self._eval("document.readyState") == "complete" and bool(
                self._eval("document.body != null")
            )
        except Exception:
            return False

    def _install_cdp(self):
        client = self.client

        def cdp(method, session_id=None, **params):
            if params:
                return client.call(method, params, session_id=session_id)
            return client.call(method, session_id=session_id)

        import jev_ultrafast.browser as browser

        browser.cdp = cdp

    def call(self, method, **params):
        return self.client.call(method, params, session_id=self.session)

    def evaluate(self, expression):
        return self._eval(expression)

    def _eval(self, expression):
        result = self.call("Runtime.evaluate", expression=expression, returnByValue=True)
        if result.get("exceptionDetails"):
            from jev_ultrafast.browser import StalePage

            raise StalePage("Document changed during evaluation")
        return result.get("result", {}).get("value")

    def observe(self, screenshot=True):
        import jev_ultrafast.browser as browser

        deadline = time.monotonic() + 15
        last = None
        while time.monotonic() < deadline:
            try:
                info = browser.browser_operation(
                    {"operation": "observe", "session": self.session, "screenshot": screenshot}
                )
                info["actions"].append({"id":"inspect_network", "kind":"inspect_network",
                                        "label":"Inspect captured network request metadata (bounded, sanitized)"})
                for i, record in enumerate(list(self.network.records.values())[-20:]):
                    if record.get("finished"):
                        info["actions"].append({"id":f"response_{i}", "kind":"read_response",
                            "request_id":record["request_id"],
                            "label":f"Read safe response JSON: {record.get('status')} {record['url']}"})
                return info
            except browser.StalePage as exc:
                last = exc
                if "navigating" not in str(exc):
                    raise
                time.sleep(0.05)
        if last:
            raise last
        raise browser.StalePage("Document is navigating")

    def fresh(self, page, action=None):
        from jev_ultrafast.browser import MARKER

        if action is not None and action["kind"] in {"click", "select", "copy_link"}:
            node = action["node"]
            current = self._eval(
                "(() => { const c=window.__jevFast; "
                f"return c ? [c.pageKey(),c.guard(c.nodes.get({int(node)}))] : null; }})()"
            )
            return current == [page["page_key"], page["guards"].get(str(node))]
        return self._eval(MARKER) == page["marker"]

    def act(self, action, page, text=None):
        import jev_ultrafast.browser as browser

        if action not in page["actions"]:
            raise ValueError("Only observed typed actions are allowed")
        if not self.fresh(page, action):
            raise browser.StalePage("Page changed since this decision. Observe again.")
        from jev_ultrafast.evidence import READ_KINDS, read_page
        if action["kind"] in READ_KINDS:
            if action["kind"] == "inspect_network":
                self.call("Runtime.evaluate", expression="1", returnByValue=True)
                return {"kind":"inspect_network", "requests":list(self.network.records.values())[-30:],
                        "dropped":self.network.dropped, "truncated":len(self.network.records)>30}
            if action["kind"] == "read_response":
                return {"kind":"read_response", **self.network.read_body(action["request_id"], self.call)}
            return read_page(self, action, page)
        result = browser.browser_operation(
            {"operation": "act", "session": self.session, "action": action, "text": text}
        )
        self.after_input = action if action["kind"] != "wait" else None
        return result

    def close(self):
        self.client.close()
        self.target = None


def terminal_result(last):
    from jev_ultrafast.evidence import sanitize, safe_url
    page = last.get("page") or {}
    result = sanitize({
        "ok":last.get("status") == "done", "status":last.get("status"),
        "url":safe_url(page.get("url") or "")[:4000], "title":str(page.get("title") or "")[:1000],
        "model":os.environ.get("TEXT_MODEL"), "steps":len(last.get("history") or []),
        "evidence":last.get("evidence", []), "evidence_dropped":last.get("evidence_dropped", 0),
        "stop_reason":last.get("stop_reason"),
        "decisions":len(last.get("decisions") or []),
        "last_operation":(last.get("decisions") or [{}])[-1].get("operation"),
        "observation":{"url":page.get("url", ""), "title":page.get("title", ""),
                       "text":str(page.get("text") or "")[:6000]},
    })
    # This code-owned enum is not an OAuth `code` from untrusted page evidence.
    if 'diagnostic' in last:
        result['diagnostic'] = last['diagnostic']
    return result


def encode_result(result):
    """Bound the serialized wire payload, not a pre-sanitization approximation."""
    def encode(value):
        return json.dumps(value, ensure_ascii=False, separators=(",", ":"), allow_nan=False)
    encoded = encode(result)
    if len(encoded.encode("utf-8")) <= 60000:
        return encoded
    def compact(value, limit):
        if isinstance(value, str):
            return value[:4000] if value.startswith(("https://", "http://")) else value[:limit]
        if isinstance(value, dict):
            return {k:compact(v, limit) for k, v in value.items()}
        if isinstance(value, list):
            return [compact(v, limit) for v in value]
        return value
    for limit in (6000, 3000, 1500, 750, 300, 100):
        bounded = compact(result, limit)
        bounded['output_truncated'] = True
        encoded = encode(bounded)
        if len(encoded.encode('utf-8')) <= 60000:
            return encoded
    # Keep all URL records until the last resort, then drop whole records explicitly.
    bounded = compact(result, 100)
    bounded['output_truncated'] = True
    while len(encode(bounded).encode('utf-8')) > 60000 and bounded.get('evidence'):
        bounded['evidence'].pop(0)
        bounded['evidence_dropped'] = bounded.get('evidence_dropped', 0) + 1
    return encode(bounded)


def run(args):
    url = str(args.get("url") or "").strip()
    goal = str(args.get("goal") or "").strip()
    if not url.startswith(("http://", "https://")) or not goal:
        return {"ok":False, "diagnostic":{"code":"INPUT_INVALID", "phase":"input"},
                "error":"url (http/https) and goal are required"}, 2
    if not os.environ.get("TYPESAFE_API_KEY") or not os.environ.get("TEXT_MODEL_API_KEY"):
        return {"ok":False, "diagnostic":{"code":"CREDENTIALS_MISSING", "phase":"input"},
                "error":"Configure TypeSafe and text-model credentials in the bot settings."}, 2
    agent = None
    last = {}
    phase = 'initialize'
    try:
        import jev_ultrafast.agent as agent_mod
        agent_mod.Browser = VisibleBrowser
        agent = agent_mod.Agent(url, goal, screenshots=False)
        last = agent.snapshot()
        # Finish before the sandbox's 180s kill so partial evidence can be returned.
        deadline = time.monotonic() + 135
        import jev_ultrafast.model as model_mod
        model_mod.RUN_DEADLINE = deadline
        for _ in range(40):
            if time.monotonic() >= deadline:
                last.update(status='blocked', stop_reason='runner_time_budget')
                break
            phase = 'tick'
            last = agent.command("tick")
            if last.get("status") in {"done", "blocked"}:
                break
        if last.get("status") not in {"done", "blocked"}:
            last.update(status="blocked", stop_reason="runner_step_budget")
        if last.get('status') == 'blocked' and not last.get('stop_reason'):
            last['stop_reason'] = 'model_blocked'
    except Exception as exc:
        if agent:
            # Snapshot can itself fail; state already owns the retained evidence.
            last = dict(agent.state)
            phase = last.get('phase', phase)
        try:
            from jev_ultrafast.diagnostics import diagnostic
            detail = diagnostic(exc, phase)
        except ImportError:
            detail = {'code':'DEPENDENCY_MISSING', 'phase':phase}
        last.update(status='blocked', stop_reason='operation_failed', diagnostic=detail)
    finally:
        if 'model_mod' in locals():
            model_mod.RUN_DEADLINE = None
        if agent and agent.state.get('browser'):
            try:
                agent.state['browser'].close()
            except Exception:
                pass  # Cleanup cannot discard the result or leak raw CDP exceptions.
    try:
        result = terminal_result(last)
    except ImportError:
        result = {'ok':False, 'status':'blocked', 'diagnostic':last.get('diagnostic')}
    return result, 0 if last.get('status') == 'done' else 1


def main() -> int:
    import contextlib
    raw = sys.stdin.read() if not sys.argv[1:] else sys.argv[1]
    try:
        args = json.loads(raw or "{}")
        if not isinstance(args, dict):
            raise ValueError()
    except ValueError:
        print(json.dumps({'ok':False, 'diagnostic':{'code':'INPUT_INVALID_JSON', 'phase':'input'}}))
        return 2
    # Dependency libraries must not contaminate JSON or leak provider internals to stderr.
    with open(os.devnull, 'w') as sink, contextlib.redirect_stdout(sink), contextlib.redirect_stderr(sink):
        try:
            result, code = run(args)
            encoded = encode_result(result)
        except Exception:
            code = 1
            encoded = json.dumps({'ok':False, 'diagnostic':{'code':'OUTPUT_ENCODING_FAILED', 'phase':'output'}})
    print(encoded)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
